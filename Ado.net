            Console.WriteLine("08. Search Employee by Name starts with 'S'.");  // done
            Console.WriteLine("09. Search Employee by Name end with 'H'.");     // done   
            Console.WriteLine("10. Employee Age Greater than 25");   // done
            Console.WriteLine("11. Employee Age Below 25");     // done
            Console.WriteLine("12. Display Employee Age is Between 25 to 30");   // done
            Console.WriteLine("13. Display Employee Names with Salary Above 25000 with Id in ASC order"); // done
            Console.WriteLine("14. Sort Employee By Name in ASC "); // done  
            Console.WriteLine("15. Sort Employee By Age in DESC"); // done
            Console.WriteLine("16. Sort Employee By Name and Age in ASC/DESC:");   // done
            Console.WriteLine("17. Delete Employee By Id");  // done
            Console.WriteLine("18. Delete Employee By City");   // done
            Console.WriteLine("19. Delete Employee whose Age below 25"); // done
            Console.WriteLine("20. Exit");
            Console.Write("Enter your choice: ");
            int choice = int.Parse(Console.ReadLine());
            switch (choice)
            {
                case 1:
                    Console.Write("Employee Name: ");
                    string name = Console.ReadLine();
                    Console.Write("Employee City: ");
                    string city = Console.ReadLine();
                    Console.Write("Employee Age: ");
                    int age = int.Parse(Console.ReadLine());
                    Console.Write("Employee Salary: ");
                    int salary = int.Parse(Console.ReadLine());

                    Employee employee = new Employee
                    {
                        EmployeeName = name,
                        EmployeeCity = city,
                        EmployeeAge = age,
                        EmployeeSalary = salary
                    };
                    AddEmployee(employee);
                    break;
                case 2:
                    DisplayEmployees();
                    break;
                case 3:
                    Console.Write("Enter Employee ID you want to be Update: ");
                    int Nid = int.Parse(Console.ReadLine());
                    Console.Write("Employee New Name: ");
                    string Nname = Console.ReadLine();
                    Console.Write("Employee New City: ");
                    string Ncity = Console.ReadLine();
                    Console.Write("Employee New Age: ");
                    int Nage = int.Parse(Console.ReadLine());
                    Console.Write("Employee New Salary: ");
                    int Nsalary = int.Parse(Console.ReadLine());
                    Program.UpdateEmployeeByID(Nid, Nname, Ncity, Nage, Nsalary);
                    break;
                case 4:
                    Console.Write("Enter Employee Name to update the salary: ");
                    string Name = Console.ReadLine();
                    Console.Write("Employee Updated Salary: ");
                    int Usalary = int.Parse(Console.ReadLine());
                    Program.UpdateEmployeeByName(Name, Usalary);
                    break;
                case 5:
                    Console.Write("Enter Employee ID you want to be Search: ");
                    int Sid = int.Parse(Console.ReadLine());
                    Program.SearchEmployeeByID(Sid);
                    break;
                case 6:
                    Console.Write("Enter Employee Name you want to be Search: ");
                    string Sname = Console.ReadLine();
                    Program.SearchEmployeeByName(Sname);
                    break;
                case 7:
                    Console.Write("Enter City you want to be Search: ");
                    string Scity = Console.ReadLine();
                    Program.SearchEmployeeByCity(Scity);
                    break;
                case 8:
                    Program.NameStartWith_S();
                    break;
                case 9:
                    Program.NameEndWith_H();
                    break;
                case 10:
                    Program.AgeGreaterThan25();
                    break;
                case 11:
                    Program.AgeLessThan25();
                    break;
                case 12:
                    Program.AgeBetween();
                    break;
                case 13:
                    Program.SalaryAbove25000();
                    break;
                case 14:
                    Program.SortNameASC();
                    break;
                case 15:
                    Program.SortAgeDESC();
                    break;
                case 16:
                    Console.Write("What you want to Sort (age or name): ");
                    string nm_age = Console.ReadLine();
                    Program.SortASCandDESC(nm_age);
                    break;
                case 17:
                    Console.Write("Enter Employee ID you want to be delete: ");
                    int del_id = int.Parse(Console.ReadLine());
                    Program.DeleteByID(del_id);
                    break;
                case 18:
                    Console.Write("Enter City you want to be delete: ");
                    string del_city = Console.ReadLine();
                    Program.DeleteByCity(del_city);
                    break;
                case 19:
                    Program.DeleteAgeBelow25();
                    break;
                case 20:
                    exit = true;
                    Console.WriteLine("Exiting the application...");
                    break;
                default:
                    Console.WriteLine("Invalid Choice.");
                    break;
            }
        }
    }
}

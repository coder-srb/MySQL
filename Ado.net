    // ------------------------------- Employee names with salary above 250000 with Id in ASC order usinh dataview-----------------------------------------------------
    public static void SalaryAbove25000()
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlCommand cmd = new SqlCommand("select * from Employees", connection);        // connected to dissconnected
                SqlDataAdapter adap = new SqlDataAdapter(cmd);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                // DataRow[] GSalary = dt.Select("EmployeeSalary > 25000", "EmployeeID ASC");
                DataView GSalary = new DataView(dt);
                GSalary.RowFilter = "EmployeeSalary > 25000";
                GSalary.Sort = "EmployeeID ASC";
                if (GSalary.Count == 0)
                {
                    Console.WriteLine("Employees not found.");
                }
                else
                {
                    Console.WriteLine("Employee names whose salary is above 25000:");
                    foreach (DataRowView dr in GSalary)
                    {
                        Console.WriteLine($"Employee Id: {dr["EmployeeId"]}\tEmployee Name: {dr["EmployeeName"]}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }


using System;
using System.Collections;
using System.Runtime.ConstrainedExecution;
using System.Threading;
using Internal;


public class Employee
{
    public int EmployeeID { get; set; }
    public string EmployeeName { get; set; }
    public int EmployeeAge { get; set; }
    public int EmployeeSalary { get; set; }

    public void DisplayEmployeeDetails()
    {
        Console.WriteLine($"Employee ID: {EmployeeID}, Employee Name: {EmployeeName}, Employee Age: {EmployeeAge}, Employee Salary: {EmployeeSalary}");
    }
}


// Custome Execption
public class EmployeeException : Exception
{
    public EmployeeException(string message) : base(message)
    {

    }
}

public class EmployeeManager
{
    public ArrayList EmployeeList { get; set; } = new ArrayList();

    public void AddEmployee(Employee employee)
    {
        foreach (Employee emp in EmployeeList)
        {
            if (emp.EmployeeID == employee.EmployeeID)
            {
                Console.WriteLine("Employee already exists.");
                return;
            }
        }
        EmployeeList.Add(employee);
        Console.WriteLine("Employee added successfully");
    }

    public void DisplayEmployees()
    {
        if (EmployeeList.Count == 0)
        {
            Console.WriteLine("Employee not found.");
        }
        else
        {
            foreach (Employee emp in EmployeeList)
            {
                emp.DisplayEmployeeDetails();
            }
        }
    }

    public void UpdateEmployee(int id, string newName, int newAge, int newSalaray)
    {
        for (int i = 0; i < EmployeeList.Count; i++)
        {
            Employee emp = (Employee)EmployeeList[i];
            if (emp.EmployeeID == id)
            {
                emp.EmployeeName = newName;
                emp.EmployeeAge = newAge;
                emp.EmployeeSalary = newSalaray;
                Console.WriteLine("Employee Updated Successfully.");
            }
            else
            {
                throw new EmployeeException("Employee not found.");
            }
        }
    }

    public void SearchEmployee(int id)
    {
        for (int i = 0; i < EmployeeList.Count; i++)
        {
            Employee emp = (Employee)EmployeeList[i];
            if (emp.EmployeeID == id)
            {
                Console.WriteLine("Employee Found Successfully.");
                Console.WriteLine($"Employee ID: {emp.EmployeeID}, Employee Name: {emp.EmployeeName}, Employee Age: {emp.EmployeeAge}, Employee Salary: {emp.EmployeeSalary}");
            }
            else
            {
                throw new EmployeeException("Employee not found.");
            }
        }
    }

    public void DeleteEmployee(int id)
    {
        for (int i = 0; i < EmployeeList.Count; i++)
        {
            Employee emp = (Employee)EmployeeList[i];
            if (emp.EmployeeID == id)
            {
                EmployeeList.Remove(emp);
                Console.WriteLine("Employee deleted successfully");
            }
            else
            {
                throw new EmployeeException("Employee not found");
            }
        }
    }

}

public class Program
{
    public static void Main(string[] args)
    {
        EmployeeManager employeeManager = new EmployeeManager();
        bool exit = false;
        while (!exit)
        {
            Console.WriteLine("Menu:");
            Console.WriteLine("1. Add Employee");
            Console.WriteLine("2. List Employee");
            Console.WriteLine("3. Update Employee");
            Console.WriteLine("4. Search Employee");
            Console.WriteLine("5. Delete Employee");
            Console.WriteLine("6. Exit");
            Console.WriteLine("Enter your choice: ");
            int choice = int.Parse(Console.ReadLine());
            switch (choice)
            {
                case 1:
                try
                {
                    Console.Write("Enter Employee ID: ");
                    int id = int.Parse(Console.ReadLine());
                    Console.Write("Enter Employee Name: ");
                    string name = Console.ReadLine();
                    Console.Write("Enter Employee Age: ");
                    int age = int.Parse(Console.ReadLine());
                    Console.Write("Enter Employee Salary: ");
                    int salary = int.Parse(Console.ReadLine());

                    Employee employee = new Employee
                    {
                        EmployeeID = id,
                        EmployeeName = name,
                        EmployeeAge = age,
                        EmployeeSalary = salary
                    };
                    employeeManager.AddEmployee(employee);
                }
                catch(FormatException ex)
                {
                     Console.WriteLine(ex.Message);
                }
                    break;
                case 2:
                    employeeManager.DisplayEmployees();
                    break;
                case 3:
                    try
                    {
                        Console.Write("Enter Employee ID you want to update: ");
                        int uid = int.Parse(Console.ReadLine());
                        Console.Write("Enter New Employee Name: ");
                        string uname = Console.ReadLine();
                        Console.Write("Enter New Employee Age: ");
                        int uage = int.Parse(Console.ReadLine());
                        Console.Write("Enter New Employee Salary: ");
                        int usalary = int.Parse(Console.ReadLine());
                        employeeManager.UpdateEmployee(uid, uname, uage, usalary);
                    }
                    catch (EmployeeException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    catch(FormatException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    break;
                case 4:
                    try
                    {
                        Console.Write("Enter Employee ID you want to search: ");
                        int sid = int.Parse(Console.ReadLine());
                        employeeManager.SearchEmployee(sid);
                    }
                    catch (EmployeeException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    catch(FormatException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    break;
                case 5:
                    try
                    {
                        Console.Write("Enter Employee ID you want to delete: ");
                        int del_id = int.Parse(Console.ReadLine());
                        employeeManager.DeleteEmployee(del_id);
                    }
                    catch (EmployeeException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    catch(FormatException ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                    break;
                case 6:
                    exit = true;
                    Console.WriteLine("Exiting Application...");
                    break;
                default:
                    Console.WriteLine("Invalid choice.");
                    break;
            }
        }
    }
}

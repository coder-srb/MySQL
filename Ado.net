Case Study: Console-based Employee Management Application Using ADO.NET
Requirements
1. Employee Class
Create an Employee class in the Models folder. It represents an employee with their details.
Properties:
EmployeeID (int): Unique identifier for the employee (auto-incremented).
EmployeeName (string): The name of the employee.
Department (string): The department where the employee works.
Salary (decimal): The salary of the employee.
. Program Class
Methods:
1. AddEmployee(Employee employee):
Add a new employee to the Employees table in the database.
Display the message "Employee added successfully." upon success.
Parameters: An Employee object containing the details of the employee to be added.
Use DataSet and SqlDataAdapter to insert the employee into the table.
2. ListEmployees():
Retrieve and display all employees from the Employees table.
Fetch data using SqlDataAdapter and print the details of each employee.
Display employee details in the format:
EmployeeID: {row["EmployeeID"]}\tEmployeeName: {row["EmployeeName"]}\tDepartment: {row["Department"]}\tSalary: {row["Salary"]}.
Handle the case where no employees are available with the error message: "No Employees available."
3. UpdateEmployee(int employeeID, string newEmployeeName, string newDepartment, decimal newSalary):
Update the details of an employee based on their EmployeeID.
Display the message "Employee details updated successfully." upon success.
Parameters:
employeeID (int): The ID of the employee to be updated.
newEmployeeName (string): The updated name of the employee.
newDepartment (string): The updated department.
newSalary (decimal): The updated salary.
Use DataSet and SqlDataAdapter to find and update the employee in the table.
Handle the case where the employee ID is not found with the error message: "Employee not found."
3. Main Menu
This serves as the entry point for the application and provides a user interface to interact with the system.
Menu Options:
Add Employee:
Allows the user to input details for a new employee and add them to the database.
List Employees:
Displays all employees currently stored in the database.
Update Employee Details:
Allows the user to update the details of an employee based on their EmployeeID.
Exit:
Terminates the application with the message: "Exiting the application..."
Database Information
Database Name: appdb
Table Name: Employees
Table Columns:
EmployeeID (int, primary key, auto-incremented)
EmployeeName (nvarchar)
Department (nvarchar)
Salary (decimal)
Error Handling:
Ensure the database connection is properly established.
Handle exceptions (e.g., invalid inputs, database errors) gracefully with user-friendly error messages.

// Employee.cs
namespace Models
{
    public class Employee
    {
        public int EmployeeID { get; set; }
        public string EmployeeName { get; set; }
        public string Department { get; set; }
        public decimal Salary { get; set; }
    }
}

// Program.cs
using System;
using System.Data;
using System.Data.SqlClient;
using Models;

class Program
{
    private static readonly string connectionString = "Server=your_server_name;Database=appdb;Trusted_Connection=True;";

    public static void AddEmployee(Employee employee)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = "SELECT * FROM Employees";
                SqlDataAdapter adapter = new SqlDataAdapter(query, connection);
                SqlCommandBuilder builder = new SqlCommandBuilder(adapter);

                DataSet dataSet = new DataSet();
                adapter.Fill(dataSet, "Employees");

                DataRow newRow = dataSet.Tables["Employees"].NewRow();
                newRow["EmployeeName"] = employee.EmployeeName;
                newRow["Department"] = employee.Department;
                newRow["Salary"] = employee.Salary;
                dataSet.Tables["Employees"].Rows.Add(newRow);

                adapter.Update(dataSet, "Employees");
                Console.WriteLine("Employee added successfully.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    public static void ListEmployees()
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = "SELECT * FROM Employees";
                SqlDataAdapter adapter = new SqlDataAdapter(query, connection);

                DataSet dataSet = new DataSet();
                adapter.Fill(dataSet, "Employees");

                DataTable table = dataSet.Tables["Employees"];

                if (table.Rows.Count > 0)
                {
                    foreach (DataRow row in table.Rows)
                    {
                        Console.WriteLine($"EmployeeID: {row["EmployeeID"]}\tEmployeeName: {row["EmployeeName"]}\tDepartment: {row["Department"]}\tSalary: {row["Salary"]}");
                    }
                }
                else
                {
                    Console.WriteLine("No Employees available.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    public static void UpdateEmployee(int employeeID, string newEmployeeName, string newDepartment, decimal newSalary)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = "SELECT * FROM Employees";
                SqlDataAdapter adapter = new SqlDataAdapter(query, connection);
                SqlCommandBuilder builder = new SqlCommandBuilder(adapter);

                DataSet dataSet = new DataSet();
                adapter.Fill(dataSet, "Employees");

                DataTable table = dataSet.Tables["Employees"];

                DataRow rowToUpdate = null;
                foreach (DataRow row in table.Rows)
                {
                    if ((int)row["EmployeeID"] == employeeID)
                    {
                        rowToUpdate = row;
                        break;
                    }
                }

                if (rowToUpdate != null)
                {
                    rowToUpdate["EmployeeName"] = newEmployeeName;
                    rowToUpdate["Department"] = newDepartment;
                    rowToUpdate["Salary"] = newSalary;

                    adapter.Update(dataSet, "Employees");
                    Console.WriteLine("Employee details updated successfully.");
                }
                else
                {
                    Console.WriteLine("Employee not found.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    static void Main(string[] args)
    {
        while (true)
        {
            Console.WriteLine("\nMenu:");
            Console.WriteLine("1 - Add Employee");
            Console.WriteLine("2 - List Employees");
            Console.WriteLine("3 - Update Employee Details");
            Console.WriteLine("4 - Exit");
            Console.Write("Enter your choice: ");

            string choice = Console.ReadLine();

            switch (choice)
            {
                case "1":
                    Console.Write("Enter Employee Name: ");
                    string employeeName = Console.ReadLine();

                    Console.Write("Enter Department: ");
                    string department = Console.ReadLine();

                    Console.Write("Enter Salary: ");
                    decimal salary = decimal.Parse(Console.ReadLine());

                    AddEmployee(new Employee { EmployeeName = employeeName, Department = department, Salary = salary });
                    break;

                case "2":
                    ListEmployees();
                    break;

                case "3":
                    Console.Write("Enter Employee ID to update: ");
                    int employeeID = int.Parse(Console.ReadLine());

                    Console.Write("Enter new Employee Name: ");
                    string newEmployeeName = Console.ReadLine();

                    Console.Write("Enter new Department: ");
                    string newDepartment = Console.ReadLine();

                    Console.Write("Enter new Salary: ");
                    decimal newSalary = decimal.Parse(Console.ReadLine());

                    UpdateEmployee(employeeID, newEmployeeName, newDepartment, newSalary);
                    break;

                case "4":
                    Console.WriteLine("Exiting the application...");
                    return;

                default:
                    Console.WriteLine("Invalid choice, please try again.");
                    break;
            }
        }
    }
}

    // ------------------------------- Sort Employee Name and Employee Age in ASC/DESC order -----------------------------------------------------
    public static void SortASCandDESC(string sortBy)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adap = new SqlDataAdapter("select * from Employees", connection);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataView dv = new DataView(dt);
                if (sortBy == "age")
                {
                    dv.Sort = "EmployeeAge ASC";
                    foreach (DataRowView dr in dv)
                    {
                        Console.WriteLine($"Employee Id: {dr["EmployeeId"]}\tEmployee Name: {dr["EmployeeName"]}\tEmployee City: {dr["EmployeeCity"]}\tEmployee Age: {dr["EmployeeAge"]}\tEmployee Salary: {dr["EmployeeSalary"]}");
                    }
                }
                else if(sortBy == "name")
                {
                    dv.Sort = "EmployeeName DESC";
                    foreach (DataRowView dr in dv)
                    {
                        Console.WriteLine($"Employee Id: {dr["EmployeeId"]}\tEmployee Name: {dr["EmployeeName"]}\tEmployee City: {dr["EmployeeCity"]}\tEmployee Age: {dr["EmployeeAge"]}\tEmployee Salary: {dr["EmployeeSalary"]}");
                    }
                }
                else
                {
                    Console.WriteLine("Invalid option selected. Enter only Age and Name.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }


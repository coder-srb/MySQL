DeleteByID(id0);
Break;
Case 9:
System.Console.Write(â€œEnter the name to search: â€œ);

String n1 = Console.ReadLine();
DeleteByName(n1);
Break;
Case 10:
Ret = false;
System.Console.WriteLine(â€œExiting the applicationâ€¦â€);
Break;

Default:

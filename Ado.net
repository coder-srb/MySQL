    // ------------------------------- Delete Employee by ID -----------------------------------------------------
    public static void DeleteByID(int id)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adap = new SqlDataAdapter("select * from Employees", connection);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataRow[] dr = dt.Select($"EmployeeID = {id}");
                if (dr.Length == 0)
                {
                    Console.WriteLine("Book not Found.");
                }
                else
                {
                    dr[0].Delete();
                    adap.Update(dt);
                }
                Console.WriteLine("Employee deleted successfully.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // ------------------------------- Delete Employee by City -----------------------------------------------------
    public static void DeleteByCity(string city)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adap = new SqlDataAdapter("select * from Employees", connection);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataRow[] del_city = dt.Select($"EmployeeCity = '{city}'");
                if (del_city.Length == 0)
                {
                    Console.WriteLine("Employee not Found.");

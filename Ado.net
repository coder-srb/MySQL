using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.Data.SqlClient;

public static class ConnectionProvider
{
    public static string connectionString = "User id=sa;password=examlyMssql@123;server=localhost;database=appdb;trusted_connection=false;persist security info=false;encrypt=false";
}

public class Employee
{
    public int EmployeeId { get; set; }
    public string EmployeeName { get; set; }
    public string EmployeeCity { get; set; }
    public int EmployeeSalary { get; set; }
    public int EmployeeAge { get; set; }
}

public class Program
{
    public static string connectionString = ConnectionProvider.connectionString;

    // ------------------------------- Add Employees ----------------------------------------------------- 
    public static void AddEmployee(Employee employee)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlCommand cmd = new SqlCommand("select * from Employees", connection);        // connected to disconnected - add only one SqlCommand line above the SqlDataAdapter.
                SqlDataAdapter adap = new SqlDataAdapter(cmd);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataRow dr = dt.NewRow();
                // dr["EmployeeID"] = employee.EmployeeId;
                dr["EmployeeName"] = employee.EmployeeName;
                dr["EmployeeCity"] = employee.EmployeeCity;
                dr["EmployeeAge"] = employee.EmployeeAge;
                dr["EmployeeSalary"] = employee.EmployeeSalary;
                dt.Rows.Add(dr);
                adap.Update(dt);                                                 // disconnected to connected
                Console.WriteLine("Employee added successfully.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // ------------------------------- Update Employee By ID ----------------------------------------------------- 
    public static void UpdateEmployeeByID(int id, string newName, string newCity, int newAge, int newSalary)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adap = new SqlDataAdapter("select * from Employees", connection);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataRow[] dr = dt.Select($"EmployeeID = {id}");
                if (dr.Length == 0)
                {
                    Console.WriteLine("Employee not found.");
                }
                else
                {
                    dr[0]["EmployeeName"] = newName;
                    dr[0]["EmployeeCity"] = newCity;
                    dr[0]["EmployeeAge"] = newAge;
                    dr[0]["EmployeeSalary"] = newSalary;
                    adap.Update(dt);
                }
            }
            Console.WriteLine("Employee updated successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // ------------------------------- Update Employee By Name ----------------------------------------------------- 
    public static void UpdateEmployeeByName(string name, int newsalary)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlDataAdapter adap = new SqlDataAdapter("select * from Employees", connection);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataRow[] dr = dt.Select($"EmployeeName = '{name}'");
                if (dr.Length == 0)
                {
                    Console.WriteLine("Employee not found.");
                }
                else
                {
                    dr[0]["EmployeeSalary"] = newsalary;
                    adap.Update(dt);
                }
            }
            Console.WriteLine("Employee updated successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // ------------------------------- Search Employee By ID using DataView ----------------------------------------------------- 
    public static void SearchEmployeeByID(int id)
    {
        try
        {
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                SqlCommand cmd = new SqlCommand("select * from Employees", connection);           // connected to disconnected
                SqlDataAdapter adap = new SqlDataAdapter(cmd);
                SqlCommandBuilder bui = new SqlCommandBuilder(adap);
                DataSet ds = new DataSet();
                adap.Fill(ds, "Employees");
                DataTable dt = ds.Tables["Employees"];
                DataView search_id = new DataView(dt);
                search_id.RowFilter = $"EmployeeID = {id}";
                if (search_id.Count == 0)
                {
                    Console.WriteLine("Employee not found.");
                }
                else
                {
                    Console.WriteLine("Employee Found successfully.");
                    foreach (DataRowView dr in search_id)
                    {
                        Console.WriteLine($"Employee Id: {dr["EmployeeId"]}\tEmployee Name: {dr["EmployeeName"]}\tEmployee City: {dr["EmployeeCity"]}\tEmployee Age: {dr["EmployeeAge"]}\tEmployee Salary: {dr["EmployeeSalary"]}");
                    }

                }
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

